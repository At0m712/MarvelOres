{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "marvelores:item/uru_axe_gui"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:model",
        "model": "marvelores:item/vibranium_shield_blocking"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "marvelores:item/uru_axe_3d"
      }
    }
  }
}